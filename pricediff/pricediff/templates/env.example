# コピーして .env として使う(.env は git に入れないこと)
# 楽天ウェブサービス(無料・登録するとすぐ発行される)
RAKUTEN_APPLICATION_ID=
RAKUTEN_AFFILIATE_ID=

# Amazon Product Advertising API 5.0(アソシエイト審査の通過が必要)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# 淘宝開放平台(未設定でも watchlist.csv の手入力価格で動く)
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=

# 為替レートを固定したい場合(1元=何円)
# PRICEDIFF_FX_CNY_JPY=21.0
